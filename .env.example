# NexxPass Sync Server Configuration

# Database connection URL (PostgreSQL 16+)
DATABASE_URL=postgres://nexxpass:change-me@localhost:5432/nexxpass_sync

# Server bind address
SYNC_BIND_ADDR=0.0.0.0:8080

# Maximum database pool connections
SYNC_DATABASE_MAX_CONNECTIONS=10

# 32-byte secret hex string used to HMAC-sign sync pull continuation tokens
# In production, generate with: openssl rand -hex 32
SYNC_TOKEN_KEY_HEX=e0e1e2e3e4e5e6e7e8e9eaebecedeeeff0f1f2f3f4f5f6f7f8f9fafbfcfdfeff

# Deployment epoch (incrementing invalidates outstanding continuation tokens)
SYNC_DEPLOYMENT_EPOCH=1

# Periodic background maintenance interval in seconds (default: 3600 = 1 hour)
SYNC_MAINTENANCE_INTERVAL_SECONDS=3600

# Tracing log level (trace, debug, info, warn, error)
RUST_LOG=info
